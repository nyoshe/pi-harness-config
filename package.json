{
  "name": "pi-harness-config",
  "version": "0.1.0",
  "description": "Personal Pi harness config: tools and skills for local-model coding sessions",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-web-access/dist",
      "./node_modules/pi-open-tui/extensions/open-tui/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@onkernel/browser-loop/src/pi-extension/index.ts",
      "./node_modules/@danielmeneses/pi-llama-swap/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@danielmeneses/pi-llama-swap": "0.1.3",
    "@juicesharp/rpiv-ask-user-question": "2.15.0",
    "@onkernel/browser-loop": "0.12.1",
    "pi-open-tui": "0.3.14",
    "pi-web-access": "0.47.0"
  },
  "bundledDependencies": [
    "@danielmeneses/pi-llama-swap",
    "@juicesharp/rpiv-ask-user-question",
    "@onkernel/browser-loop",
    "pi-open-tui",
    "pi-web-access"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
