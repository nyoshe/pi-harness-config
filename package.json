  "bundledDependencies": ["@juicesharp/rpiv-ask-user-question", "pi-open-tui", "pi-web-access"],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
